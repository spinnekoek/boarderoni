{
  "name": "boarderoni",
  "version": "0.1.0-alpha.1",
  "description": "Boarderoni: design button/macro dashboards on desktop, drive them from an Android WebView client",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --build --force",
    "generate:mcp-schemas": "tsx scripts/generate-mcp-schemas.ts",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "keywords": [],
  "author": "",
