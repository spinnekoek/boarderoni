            "expr": "const modTime = parseInt(variables.$value, 10);\nconst onInit = modTime < 2;\n\nif (onInit){ \nconsole.log(\"init tick\");\n}\nreturn { \n  EMERGENCY_PARKING_BRAKE_HALF_ROTATE : onInit ? 0 : variables.EMERGENCY_PARKING_BRAKE_HALF_ROTATE, \n  AB_DETENT_ON: 0,\n  MOD_TIME: variables.$value \n};\n"
