      {
        "id": "b920cb3e-155d-4af8-86ad-510de2b00981",
        "kind": "datetime",
        "name": "Date & Time",
        "mappings": [
          {
            "id": "be2abcb7-fbfa-472c-8a48-2a09861690ce",
