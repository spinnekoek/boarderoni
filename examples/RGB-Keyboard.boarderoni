    "canvasWidth": 1027,
    "canvasHeight": 377,
    "gridSize": 5,
    "globalActions": [
      {
        "id": "rgb-engine",
        "name": "RGB engine",
        "enabled": true,
        "watch": [
          "rgb_t",
          "rgb_on",
          "rgb_mode"
        ],
        "condition": "return true;",
        "trigger": "always",
        "steps": [
          {
            "kind": "action",
            "id": "rgb-engine-step",
            "action": {
              "kind": "update-state",
              "code": "// RGB engine: writes rgb_k<i> (hex color, '' = off) for each key.\nconst KEYS=[[180,40],[110,40],[250,40],[320,40],[390,40],[460,40],[530,40],[600,40],[670,40],[740,40],[40,40],[50,110],[60,180],[80,250],[48,320],[130,110],[200,110],[270,110],[340,110],[410,110],[480,110],[550,110],[620,110],[690,110],[760,110],[150,180],[220,180],[290,180],[360,180],[430,180],[500,180],[570,180],[640,180],[710,180],[190,250],[260,250],[330,250],[400,250],[470,250],[540,250],[610,250],[680,250],[750,250],[820,250],[780,180],[850,180],[830,110],[900,110],[980,110],[810,40],[880,40],[130,320],[210,320],[475,330],[740,320],[900,320],[982,320],[970,40],[955,180],[940,250],[820,320]]; // [cx,cy] per key, index = rgb_k<i>\nconst t=variables.rgb_t||0, mode=variables.rgb_on ? (variables.rgb_mode||'wave') : 'off';\nconst speed=variables.rgb_speed||1, T=t*speed;\nfunction hx(h,s,l){s/=100;l/=100;const k=n=>(n+h/30)%12,a=s*Math.min(l,1-l),f=n=>Math.round(255*(l-a*Math.max(-1,Math.min(k(n)-3,9-k(n),1)))).toString(16).padStart(2,'0');return '#'+f(0)+f(8)+f(4);}\nconst H=h=>((h%360)+360)%360;\nconst rnd=n=>{const s=Math.sin(n*12.9898)*43758.5453;return s-Math.floor(s);};\nconst out={};\nKEYS.forEach(([x,y],i)=>{\n  let c='';\n  if(mode==='wave') c=hx(H(T/8+x*0.4+y*0.25),95,62);\n  else if(mode==='cycle') c=hx(H(T/20),95,62);\n  else if(mode==='breathe') c=hx(H(T/200),95,15+47*(0.5+0.5*Math.sin(T/600)));\n  else if(mode==='night') {\n    // deep blue/indigo, very dim, slow shimmer\n    const s=0.5+0.5*Math.sin(T/2500+x*0.01+y*0.02);\n    c=hx(230+25*s,80,40+10*s);\n  }\n  else if(mode==='cyberpunk') {\n    // magenta/cyan diagonal bands + random yellow glitch flickers\n    const b=Math.sin(T/700+(x-y*0.6)/90);\n    const bucket=Math.floor(T/120);\n    if(rnd(i*7.13+bucket)>0.985) c=hx(55,100,60);\n    else c=b>0?hx(315,100,58):hx(185,100,52);\n  }\n  else if(mode==='ripple') {\n    // rings expanding from the last pressed key (auto-ripple from random keys when idle)\n    let rx=variables.rgb_rx, ry=variables.rgb_ry, rt=variables.rgb_rt||0;\n    const P=Math.round(2200/speed); if(!rt || t-rt>P+1000) { const k=Math.floor(t/P); const p=KEYS[Math.floor(rnd(k)*KEYS.length)]; rx=p[0]; ry=p[1]; rt=k*P; }\n    const age=(t-rt)*speed, r=age*0.5, dist=Math.hypot(x-rx,y-ry);\n    const fade=Math.max(0,1-age/2000);\n    const ring=Math.max(0,1-Math.abs(dist-r)/55)*fade;\n    const inner=(dist<r?0.25:0)*fade;\n    const hue=H(rt/15);\n    c=hx(H(hue+dist*0.15),95,18+55*Math.max(ring,inner));\n  }\n  out['rgb_k'+i]=c;\n});\nreturn out;"
            }
          }
        ]
      }
    ]
  }
}